{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2024",
        "outDir": "out",
        "noEmit": true,
        "lib": [
            "es2024"
        ],
        "types": ["node", "vscode"],
        "sourceMap": true,
        "rootDir": ".",
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "strictNullChecks": true,
        "noUnusedParameters": true,
        "alwaysStrict": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
