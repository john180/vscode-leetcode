{
  "version": 1,
  "skip_dirs": [
    ".git",
    ".vscode",
    ".vscode-test",
    "node_modules",
    "dist",
    "out-test",
    ".idea"
  ],
  "skip_prefixes": [],
  "skip_globs": [
    "*.vsix"
  ],
  "encoding": [
    {
      "glob": "*.ts",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.js",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.ps1",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".vscodeignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.ts"
    ],
    "limit": 210,
    "tab_width": 4
  },
  "forbidden": [
    {
      "id": "expired-npm-mirror",
      "globs": [
        "package-lock.json"
      ],
      "pattern": "r2\\.cnpmjs\\.org",
      "message": "use registry.npmjs.org; the cnpm mirror certificate is expired"
    },
    {
      "id": "no-extension-telemetry",
      "globs": [
        "src/*.ts",
        "src/**/*.ts",
        "package.json",
        "package.nls*.json"
      ],
      "pattern": "analysis\\.leetcode\\.cn|analysis\\.lingkou\\.xyz|allowReportData|TrackData",
      "message": "telemetry was inherited from upstream and intentionally removed; do not reintroduce it"
    }
  ],
  "versions": [
    {
      "id": "package-version",
      "sources": [
        {
          "path": "package.json",
          "pattern": "\"version\":\\s*\"(\\d+)\\.(\\d+)\\.(\\d+)\""
        },
        {
          "path": "package-lock.json",
          "pattern": "\"version\":\\s*\"(\\d+)\\.(\\d+)\\.(\\d+)\""
        },
        {
          "path": "CHANGELOG.md",
          "pattern": "(?m)^## \\[(\\d+)\\.(\\d+)\\.(\\d+)\\]"
        },
        {
          "path": "CHANGELOG.zh-CN.md",
          "pattern": "(?m)^## \\[(\\d+)\\.(\\d+)\\.(\\d+)\\]"
        }
      ]
    }
  ],
  "changelog": null,
  "required_files": [
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "package.json",
    "package-lock.json",
    ".vscodeignore",
    ".gitattributes",
    "src/extension.ts",
    "repo-rules.json",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".githooks/commit-msg",
    ".github/workflows/build.yml",
    "CHANGELOG.zh-CN.md"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.en.md"
      ],
      "switch_line": true
    }
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto",
      "\\*\\.ts\\s+text eol=lf",
      "\\*\\.md\\s+text eol=lf"
    ]
  },
  "comments": {
    "english": true
  },
  "commit_message": {
    "english": true
  }
}
